// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A saved account, shared by everyone who signs up — this app doesn't have per-user data.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  // Whether the homepage "This Week" nutrition card is shown — off by request, on by default.
  showThisWeekCard Boolean @default(true)

  // New accounts are "guests" (browse-only — see requireVerifiedUserId in lib/auth.ts) until
  // they click the link emailed to verificationToken. Token is cleared once used; a fresh one
  // is generated and re-emailed on request from the profile page.
  emailVerified              Boolean   @default(false)
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?

  // --- Pro subscription (see lib/plan.ts + lib/stripe.ts) ---
  plan                           String    @default("free") // free | pro
  stripeCustomerId               String?   @unique
  stripeSubscriptionId           String?   @unique
  subscriptionStatus             String? // active | canceled | past_due | trialing
  subscriptionInterval           String? // month | year
  subscriptionRenewsAt           DateTime?
  subscriptionCancelAtPeriodEnd  Boolean   @default(false)

  // --- Living pantry (see lib/pantry.ts) ---
  // How often they grocery shop, set during pantry onboarding — paces the staleness nudges
  // so a biweekly shopper isn't nagged on a weekly shopper's schedule.
  groceryCadence        String? // weekly | biweekly | whenever
  pantryOnboardedAt     DateTime?
  // Bumped by any pantry add/remove/quick-refresh confirm — the "how stale is this" clock.
  pantryLastConfirmedAt DateTime?
  // Running count of ingredients a smart cart excluded because pantry already had them —
  // the "your pantry has saved you from buying X ingredients" stat on the subscription page.
  ingredientsSavedByPantry Int @default(0)

  recipesCreated Recipe[]
  foldersCreated Folder[]
}

model Recipe {
  id          String   @id @default(cuid())
  sourceUrl   String   @unique

  title         String
  authorHandle  String?
  thumbnailPath String? // set when a frame was extracted locally (full pipeline)
  thumbnailUrl  String? // set when reusing TikTok's own hosted thumbnail (lite pipeline)
  caption       String?
  transcript    String?
  userNotes     String?

  durationSeconds  Int?
  servings         Int?
  totalTimeMinutes Int?

  difficulty        String? // easy | medium | hard
  proteinType       String? // chicken | beef | pork | seafood | egg | plant-based | other | none
  dietType          String? // vegan | vegetarian | pescatarian | omnivore
  mealType          String? // breakfast | lunch | dinner | quick-bite
  priceLevel        String? // budget | moderate | splurge
  estimatedPriceUsd Float?

  ingredientsJson String // JSON: { item, quantity }[]
  instructionsJson String // JSON: string[]
  tipsJson         String? // JSON: string[]
  // JSON: { caloriesPerServing, proteinGrams, carbsGrams, fatGrams, fiberGrams, sugarGrams, sodiumMg }
  // Per serving, estimated by the model — null for recipes saved before this field existed.
  nutritionJson    String?
  confidenceNotes  String?

  personalNotes String? // freeform notes the user typed in after saving (tweaks, substitutions, etc.)
  folderId      String?
  folder        Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  cookLogs CookLog[]

  createdAt DateTime @default(now())

  // Whoever saved this recipe — the library itself stays shared (everyone sees every
  // recipe), this only exists so the free-tier 10-recipe cap counts what YOU personally
  // saved rather than the whole household's shared count.
  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Set when this recipe's ingredients were sent to a delivery cart — powers the
  // "Ordered via Cutesy Eats" tag on the weekly nutrition snapshot.
  lastOrderedViaAppAt DateTime?

  cartOrders CartOrder[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  createdAt DateTime @default(now())

  recipes Recipe[]

  // Same attribution-only purpose as Recipe.createdByUserId — powers the free-tier
  // 2-folder cap without making folders themselves per-user/private.
  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
}

// A staple the household keeps stocked (olive oil, garlic, pasta, …), used to check
// which recipe ingredients are already on hand.
model PantryItem {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now())
  // Bumped whenever this item is (re)confirmed — via onboarding, the full pantry page,
  // or the quick-refresh sheet. Distinct from createdAt so "last confirmed 3 days ago"
  // reads right even for an item added months back.
  lastConfirmedAt DateTime @default(now())
}

// One "send to a delivery app" action from the Smart Cart or "Shop this recipe" —
// powers the nutrition snapshot's "Ordered via Cutesy Eats" tag and the pantry-savings
// stat on the subscription page.
model CartOrder {
  id        String   @id @default(cuid())
  provider  String // instacart | amazon-fresh
  itemsJson String // JSON: string[] of ingredient names sent to the delivery app
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// One "I made this!" event from Cook Mode — powers cook counts, the "haven't
// made in a while" swiper logic's server-side view, and the weekly nutrition
// snapshot (each log contributes one serving of its recipe's estimated nutrition).
model CookLog {
  id       String   @id @default(cuid())
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedAt DateTime @default(now())
  rating   Int? // 1-5 stars, optional
}
