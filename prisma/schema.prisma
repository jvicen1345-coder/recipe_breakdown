// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A saved account. userId columns elsewhere are nullable rather than backfilled at
// migration time — pre-existing rows stay unowned (userId null) until the very first
// signup claims them (see /api/auth/signup), so a fresh deploy with existing data never
// needs a hardcoded "legacy owner" account.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  // Whether the homepage "This Week" nutrition card is shown — off by request, on by default.
  showThisWeekCard Boolean @default(true)

  recipes     Recipe[]
  folders     Folder[]
  pantryItems PantryItem[]
  cookLogs    CookLog[]
}

model Recipe {
  id          String   @id @default(cuid())
  sourceUrl   String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  authorHandle  String?
  thumbnailPath String? // set when a frame was extracted locally (full pipeline)
  thumbnailUrl  String? // set when reusing TikTok's own hosted thumbnail (lite pipeline)
  caption       String?
  transcript    String?
  userNotes     String?

  durationSeconds  Int?
  servings         Int?
  totalTimeMinutes Int?

  difficulty        String? // easy | medium | hard
  proteinType       String? // chicken | beef | pork | seafood | egg | plant-based | other | none
  dietType          String? // vegan | vegetarian | pescatarian | omnivore
  priceLevel        String? // budget | moderate | splurge
  estimatedPriceUsd Float?

  ingredientsJson String // JSON: { item, quantity }[]
  instructionsJson String // JSON: string[]
  tipsJson         String? // JSON: string[]
  // JSON: { caloriesPerServing, proteinGrams, carbsGrams, fatGrams, fiberGrams, sugarGrams, sodiumMg }
  // Per serving, estimated by the model — null for recipes saved before this field existed.
  nutritionJson    String?
  confidenceNotes  String?

  personalNotes String? // freeform notes the user typed in after saving (tweaks, substitutions, etc.)
  folderId      String?
  folder        Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  cookLogs CookLog[]

  createdAt DateTime @default(now())

  // Two accounts may independently save the same TikTok link, so uniqueness is per-user
  // rather than global; unowned (userId null) rows can't collide since Postgres treats
  // NULL as distinct in a unique index.
  @@unique([userId, sourceUrl])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipes Recipe[]
}

// A staple the user keeps stocked (olive oil, garlic, pasta, …), used to check
// which recipe ingredients they already have on hand.
model PantryItem {
  id        String   @id @default(cuid())
  name      String
  category  String
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

// One "I made this!" event from Cook Mode — powers cook counts, the "haven't
// made in a while" swiper logic's server-side view, and the weekly nutrition
// snapshot (each log contributes one serving of its recipe's estimated nutrition).
model CookLog {
  id       String   @id @default(cuid())
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedAt DateTime @default(now())
  rating   Int? // 1-5 stars, optional

  // Denormalized from recipe.userId at creation time so cook-log queries (streaks,
  // weekly snapshots) can filter directly without joining through Recipe.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
