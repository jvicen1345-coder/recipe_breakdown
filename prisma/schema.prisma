// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          String   @id @default(cuid())
  sourceUrl   String   @unique

  title         String
  authorHandle  String?
  thumbnailPath String? // set when a frame was extracted locally (full pipeline)
  thumbnailUrl  String? // set when reusing TikTok's own hosted thumbnail (lite pipeline)
  caption       String?
  transcript    String?
  userNotes     String?

  durationSeconds  Int?
  servings         Int?
  totalTimeMinutes Int?

  difficulty        String? // easy | medium | hard
  proteinType       String? // chicken | beef | pork | seafood | egg | plant-based | other | none
  dietType          String? // vegan | vegetarian | pescatarian | omnivore
  priceLevel        String? // budget | moderate | splurge
  estimatedPriceUsd Float?

  ingredientsJson String // JSON: { item, quantity }[]
  instructionsJson String // JSON: string[]
  tipsJson         String? // JSON: string[]
  // JSON: { caloriesPerServing, proteinGrams, carbsGrams, fatGrams, fiberGrams, sugarGrams, sodiumMg }
  // Per serving, estimated by the model — null for recipes saved before this field existed.
  nutritionJson    String?
  confidenceNotes  String?

  personalNotes String? // freeform notes the user typed in after saving (tweaks, substitutions, etc.)
  folderId      String?
  folder        Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  createdAt DateTime @default(now())

  recipes Recipe[]
}
