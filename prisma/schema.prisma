// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A saved account, shared by everyone who signs up — this app doesn't have per-user data.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  // Whether the homepage "This Week" nutrition card is shown — off by request, on by default.
  showThisWeekCard Boolean @default(true)

  // New accounts are "guests" (browse-only — see requireVerifiedUserId in lib/auth.ts) until
  // they click the link emailed to verificationToken. Token is cleared once used; a fresh one
  // is generated and re-emailed on request from the profile page.
  emailVerified              Boolean   @default(false)
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?
}

model Recipe {
  id          String   @id @default(cuid())
  sourceUrl   String   @unique

  title         String
  authorHandle  String?
  thumbnailPath String? // set when a frame was extracted locally (full pipeline)
  thumbnailUrl  String? // set when reusing TikTok's own hosted thumbnail (lite pipeline)
  caption       String?
  transcript    String?
  userNotes     String?

  durationSeconds  Int?
  servings         Int?
  totalTimeMinutes Int?

  difficulty        String? // easy | medium | hard
  proteinType       String? // chicken | beef | pork | seafood | egg | plant-based | other | none
  dietType          String? // vegan | vegetarian | pescatarian | omnivore
  mealType          String? // breakfast | lunch | dinner | quick-bite
  priceLevel        String? // budget | moderate | splurge
  estimatedPriceUsd Float?

  ingredientsJson String // JSON: { item, quantity }[]
  instructionsJson String // JSON: string[]
  tipsJson         String? // JSON: string[]
  // JSON: { caloriesPerServing, proteinGrams, carbsGrams, fatGrams, fiberGrams, sugarGrams, sodiumMg }
  // Per serving, estimated by the model — null for recipes saved before this field existed.
  nutritionJson    String?
  confidenceNotes  String?

  personalNotes String? // freeform notes the user typed in after saving (tweaks, substitutions, etc.)
  folderId      String?
  folder        Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  cookLogs CookLog[]

  createdAt DateTime @default(now())
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  createdAt DateTime @default(now())

  recipes Recipe[]
}

// A staple the household keeps stocked (olive oil, garlic, pasta, …), used to check
// which recipe ingredients are already on hand.
model PantryItem {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now())
}

// One "I made this!" event from Cook Mode — powers cook counts, the "haven't
// made in a while" swiper logic's server-side view, and the weekly nutrition
// snapshot (each log contributes one serving of its recipe's estimated nutrition).
model CookLog {
  id       String   @id @default(cuid())
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedAt DateTime @default(now())
  rating   Int? // 1-5 stars, optional
}
