// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A saved account, shared by everyone who signs up — this app doesn't have per-user data.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Null for accounts created via "Continue with Google" that never set a password.
  passwordHash String?
  // Google's stable per-account "sub" id, set once a Google sign-in has linked this
  // account (either created it, or matched it to an existing email/password account).
  googleId     String?  @unique
  name         String?
  createdAt    DateTime @default(now())

  // Whether the homepage "This Week" nutrition card is shown — off by request, on by default.
  showThisWeekCard Boolean @default(true)

  // New accounts are "guests" (browse-only — see requireVerifiedUserId in lib/auth.ts) until
  // they click the link emailed to verificationToken. Token is cleared once used; a fresh one
  // is generated and re-emailed on request from the profile page.
  emailVerified              Boolean   @default(false)
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?

  // --- Pro subscription (see lib/plan.ts + lib/stripe.ts) ---
  plan                           String    @default("free") // free | pro
  stripeCustomerId               String?   @unique
  stripeSubscriptionId           String?   @unique
  subscriptionStatus             String? // active | canceled | past_due | trialing
  subscriptionInterval           String? // month | year
  subscriptionRenewsAt           DateTime?
  subscriptionCancelAtPeriodEnd  Boolean   @default(false)

  // --- Living pantry (see lib/pantry.ts) ---
  // How often they grocery shop, set during pantry onboarding — paces the staleness nudges
  // so a biweekly shopper isn't nagged on a weekly shopper's schedule.
  groceryCadence        String? // weekly | biweekly | whenever
  pantryOnboardedAt     DateTime?
  // Bumped by any pantry add/remove/quick-refresh confirm — the "how stale is this" clock.
  pantryLastConfirmedAt DateTime?
  // Running count of ingredients a smart cart excluded because pantry already had them —
  // the "your pantry has saved you from buying X ingredients" stat on the subscription page.
  ingredientsSavedByPantry Int @default(0)

  // --- Personal macro goals (see lib/nutritionGoals.ts) — null falls back to the app's
  // soft defaults, so most accounts never write these rows at all. ---
  goalCalories Int?
  goalProtein  Int?
  goalCarbs    Int?
  goalFat      Int?

  // --- Community submissions + points (see lib/community.ts) ---
  points Int @default(0)
  // Extends Pro access without touching Stripe at all — bumped by 30 days each time
  // the 500-point free-Pro-month reward fires. isPro() treats a future date here as
  // equivalent to plan === "pro".
  proAccessUntil DateTime?

  recipesCreated       Recipe[]
  foldersCreated       Folder[]
  communitySubmissions CommunitySubmission[]
  submissionVotes      SubmissionVote[]
  madeItPosts          MadeItPost[]
  madeItHearts         MadeItHeart[]
  madeItReports        MadeItReport[]
  notifications        Notification[]
}

model Recipe {
  id          String   @id @default(cuid())
  sourceUrl   String   @unique

  title         String
  authorHandle  String?
  thumbnailPath String? // set when a frame was extracted locally (full pipeline)
  thumbnailUrl  String? // set when reusing TikTok's own hosted thumbnail (lite pipeline)
  caption       String?
  transcript    String?
  userNotes     String?

  durationSeconds  Int?
  servings         Int?
  totalTimeMinutes Int?

  difficulty        String? // easy | medium | hard
  proteinType       String? // chicken | beef | pork | seafood | egg | plant-based | other | none
  dietType          String? // vegan | vegetarian | pescatarian | omnivore
  mealType          String? // breakfast | lunch | dinner | quick-bite
  priceLevel        String? // budget | moderate | splurge
  estimatedPriceUsd Float?

  ingredientsJson String // JSON: { item, quantity }[]
  instructionsJson String // JSON: string[]
  tipsJson         String? // JSON: string[]
  // JSON: { caloriesPerServing, proteinGrams, carbsGrams, fatGrams, fiberGrams, sugarGrams, sodiumMg }
  // Per serving, estimated by the model — null for recipes saved before this field existed.
  nutritionJson    String?
  confidenceNotes  String?

  personalNotes String? // freeform notes the user typed in after saving (tweaks, substitutions, etc.)
  folderId      String?
  folder        Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  cookLogs CookLog[]

  createdAt DateTime @default(now())

  // Whoever saved this recipe — the library itself stays shared (everyone sees every
  // recipe), this only exists so the free-tier 10-recipe cap counts what YOU personally
  // saved rather than the whole household's shared count.
  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Set when this recipe's ingredients were sent to a delivery cart — powers the
  // "Ordered via Cutesy Eats" tag on the weekly nutrition snapshot.
  lastOrderedViaAppAt DateTime?

  cartOrders CartOrder[]

  // Present only for recipes born from an approved community submission — that's
  // what makes a recipe "from our community" rather than a regular TikTok save.
  communitySubmission CommunitySubmission?

  madeItPosts MadeItPost[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  createdAt DateTime @default(now())

  recipes Recipe[]

  // Same attribution-only purpose as Recipe.createdByUserId — powers the free-tier
  // 2-folder cap without making folders themselves per-user/private.
  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
}

// A staple the household keeps stocked (olive oil, garlic, pasta, …), used to check
// which recipe ingredients are already on hand.
model PantryItem {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now())
  // Bumped whenever this item is (re)confirmed — via onboarding, the full pantry page,
  // or the quick-refresh sheet. Distinct from createdAt so "last confirmed 3 days ago"
  // reads right even for an item added months back.
  lastConfirmedAt DateTime @default(now())
}

// One "send to a delivery app" action from the Smart Cart or "Shop this recipe" —
// powers the nutrition snapshot's "Ordered via Cutesy Eats" tag and the pantry-savings
// stat on the subscription page.
model CartOrder {
  id        String   @id @default(cuid())
  provider  String // instacart | amazon-fresh | walmart | kroger | doordash
  itemsJson String // JSON: string[] of ingredient names sent to the delivery app
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  // Which UI surface sent the click — recipe_page | grocery_list | smart_cart | girl_dinner |
  // cook_mode_exit. Powers affiliate-click analytics (which context converts best).
  source    String?
  createdAt DateTime @default(now())
}

// One "I made this!" event from Cook Mode — powers cook counts, the "haven't
// made in a while" swiper logic's server-side view, and the weekly nutrition
// snapshot (each log contributes one serving of its recipe's estimated nutrition).
model CookLog {
  id       String   @id @default(cuid())
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedAt DateTime @default(now())
  rating   Int? // 1-5 stars, optional
}

// A hand-typed meal that didn't come from a saved recipe (see lib/nutritionGoals.ts and
// the Week tab's "+ Log a meal" sheet) — shared across the household like CookLog, not
// per-user, so it slots into the same weekly totals/meal list.
model ManualMealLog {
  id                 String   @id @default(cuid())
  name               String
  caloriesPerServing Int?
  proteinGrams       Int?
  carbsGrams         Int?
  fatGrams           Int?
  photoUrl           String?
  loggedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
}

// One community recipe submission, working through the moderation pipeline described
// in lib/community.ts: draft -> pending_ai -> pending_community -> pending_admin ->
// approved | rejected (or auto_rejected straight out of the community vote).
model CommunitySubmission {
  id     String @id @default(cuid())
  status String @default("draft")

  submittedByUserId String
  submittedBy       User   @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)

  title           String
  description     String
  cuisineType     String?
  dietTagsJson    String  @default("[]") // JSON: string[]
  cookTimeMinutes Int?
  difficulty      String? // easy | medium | hard

  ingredientsJson  String @default("[]") // JSON: { amount, unit, name }[]
  instructionsJson String @default("[]") // JSON: string[]

  // The verification-layer personal story — required, minimum 50 characters.
  story String @default("")

  photoUrl               String?
  photoWidth             Int?
  photoHeight            Int?
  photoFlaggedScreenshot Boolean @default(false)

  // Optional manual nutrition entry, same shape as Recipe.nutritionJson — AI-estimated
  // on approval when left blank.
  nutritionJson String?

  // JSON: string[] of human-readable reasons Layer 1 pre-screening flagged this
  // submission (empty array means it sailed straight through to community review).
  aiFlagsJson String @default("[]")

  rejectionReason String?

  approvedRecipeId String? @unique
  approvedRecipe   Recipe? @relation(fields: [approvedRecipeId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  // Null while still a draft — set the moment "Submit for review" is pressed, and
  // what the weekly submission-cap and points-on-submit logic key off of.
  submittedAt DateTime?
  reviewedAt  DateTime?

  votes SubmissionVote[]
}

// A trusted reviewer's Yes / Not sure / No verdict on one community submission —
// three of these decide whether a submission moves to admin review or gets
// auto-rejected (see lib/community.ts:tallyVotes).
model SubmissionVote {
  id           String              @id @default(cuid())
  submissionId String
  submission   CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voterUserId  String
  voter        User                @relation(fields: [voterUserId], references: [id], onDelete: Cascade)
  vote         String // yes | not_sure | no
  createdAt    DateTime            @default(now())

  @@unique([submissionId, voterUserId])
}

// A "Made It" share — a photo + rating a user posted to the community feed after
// finishing Cook Mode. Always implies a community post; the flow's "just comment on
// TikTok" path never creates one of these (see MadeItFlow).
model MadeItPost {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  photoUrl    String
  photoWidth  Int
  photoHeight Int
  caption     String? // max MAX_CAPTION_LENGTH chars, enforced at the API layer
  rating      Int // 1-5

  // Set once a report threshold is hit — hides the post from the public feed without
  // deleting it. No admin review queue for these yet; this is the "basic" moderation
  // the spec asked for.
  hiddenAt DateTime?

  createdAt DateTime @default(now())

  hearts  MadeItHeart[]
  reports MadeItReport[]
}

// One user's heart on a post — permanent (no unheart) so the capped point award below
// can never be gamed by toggling. @@unique enforces one heart per user per post.
model MadeItHeart {
  id     String     @id @default(cuid())
  postId String
  post   MadeItPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

// A "Report this post" tap — @@unique so one user can't spam reports on the same
// post to force it hidden; see HEART_POINT_CAP-style threshold in lib/madeIt.ts.
model MadeItReport {
  id             String     @id @default(cuid())
  postId         String
  post           MadeItPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterUserId String
  reporter       User       @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, reporterUserId])
}

// A small in-app (not OS-level push) notification — today only used for "someone
// loved your X 💕" — surfaced as a one-shot toast the next time the recipient opens
// the app, then marked read.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}
