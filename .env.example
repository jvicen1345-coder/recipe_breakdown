# Postgres connection string used by Prisma. Required — get one from your hosting
# provider's Postgres add-on (Vercel Postgres, Neon, Supabase, Railway, etc.) or
# point it at a local Postgres instance for development.
DATABASE_URL="postgresql://user:password@localhost:5432/recipe_breakdown"

# Required. Used to turn the video's caption/transcript/frames into a structured recipe.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to "claude-sonnet-5" if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Model used by the "Your Recipes" smart search (natural-language matching
# against your saved recipes). Defaults to "claude-haiku-4-5-20251001" if unset.
ANTHROPIC_SEARCH_MODEL=claude-haiku-4-5-20251001

# Optional but recommended. Used to transcribe the video's spoken narration via
# OpenAI's Whisper API. Without it, recipes are built from the caption, on-screen
# text in sampled frames, and any notes you add — narrated-only steps may be missed.
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=

# Optional. Defaults to "whisper-1" if unset.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional overrides if yt-dlp/ffmpeg/ffprobe aren't on PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Required for login sessions to be secure. Any long random string
# (e.g. `openssl rand -base64 32`). Without it, sessions fall back to an
# insecure dev-only secret — fine for local dev, not for a real deployment.
AUTH_SECRET=

# Optional but recommended. Used to email new accounts a confirm-your-email link —
# until they click it, they're a "guest" (browse-only, see the profile page).
# Without it, the confirm link is just logged to the server console instead of
# emailed, which is fine for local dev. Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. The "from" address on verification emails. Defaults to Resend's shared
# sandbox sender (onboarding@resend.dev), which works immediately with no setup but
# is more likely to land in spam — verify your own domain in Resend and set this to
# something like "Cutesy Eats <hello@yourdomain.com>" for real deployments.
RESEND_FROM_EMAIL=

# Optional but required for real Pro subscriptions. Without these, "Upgrade to Pro"
# flips the account to Pro directly in a clearly-labeled test mode — no card, no
# charge — so the whole upsell funnel works end to end before you connect billing.
# Get keys at https://dashboard.stripe.com/apikeys, then create a monthly and a
# yearly recurring Price for Pro in the Stripe dashboard and paste their IDs below.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# From the webhook endpoint you create at https://dashboard.stripe.com/webhooks
# pointing at <your-domain>/api/billing/webhook (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted).
STRIPE_WEBHOOK_SECRET=

# Optional. Appended to affiliate deep links across the app (grocery list "Ready to
# shop?" banner, "Shop this recipe", Smart Cart) so orders earn a commission — see
# lib/delivery.ts. Without these, every link still works, just unattributed.
INSTACART_AFFILIATE_ID=
AMAZON_ASSOCIATE_TAG=
WALMART_AFFILIATE_ID=
DOORDASH_AFFILIATE_ID=

# Optional, and not yet usable — Kroger requires a Developer Platform app approval
# (gated behind having an LLC) before these do anything. Until then, Kroger's button
# is visible but marked "Coming soon" and just links to a plain product search.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Optional. Flip to "true" once Instacart's Developer Platform partner application is
# approved and INSTACART_API_KEY is set — upgrades "Shop this recipe"/the grocery
# banner from a search-link hand-off to a real pre-populated cart with zero UI changes.
# Leave unset/false until then.
INSTACART_DEVELOPER_APPROVED=
INSTACART_API_KEY=
# Same idea for Kroger, once its Developer Platform app is approved.
KROGER_DEVELOPER_APPROVED=

# Optional. Powers the "Continue with Google" button on the login/signup pages —
# without these, clicking it shows a friendly "not set up yet" message instead of
# signing anyone in. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application) and add
# <your-domain>/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Comma-separated list of account emails allowed onto the owner-only
# /admin/community dashboard (approve/reject community recipe submissions). Without
# this set, that dashboard is inaccessible to everyone.
ADMIN_EMAILS=
