# Postgres connection string used by Prisma. Required — get one from your hosting
# provider's Postgres add-on (Vercel Postgres, Neon, Supabase, Railway, etc.) or
# point it at a local Postgres instance for development.
DATABASE_URL="postgresql://user:password@localhost:5432/recipe_breakdown"

# Required. Used to turn the video's caption/transcript/frames into a structured recipe.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to "claude-sonnet-5" if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Model used by the "Your Recipes" smart search (natural-language matching
# against your saved recipes). Defaults to "claude-haiku-4-5-20251001" if unset.
ANTHROPIC_SEARCH_MODEL=claude-haiku-4-5-20251001

# Optional but recommended. Used to transcribe the video's spoken narration via
# OpenAI's Whisper API. Without it, recipes are built from the caption, on-screen
# text in sampled frames, and any notes you add — narrated-only steps may be missed.
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=

# Optional. Defaults to "whisper-1" if unset.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional overrides if yt-dlp/ffmpeg/ffprobe aren't on PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Required for login sessions to be secure. Any long random string
# (e.g. `openssl rand -base64 32`). Without it, sessions fall back to an
# insecure dev-only secret — fine for local dev, not for a real deployment.
AUTH_SECRET=

# Required to unlock the access-request approval panel on /profile. Sign up with
# this exact email and you'll skip the invite gate and be able to approve everyone
# else's requests from there.
OWNER_EMAIL=
